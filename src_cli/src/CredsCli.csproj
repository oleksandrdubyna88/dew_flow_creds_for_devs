<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>creds</AssemblyName>
    <RootNamespace>CredsCli</RootNamespace>
    <!-- Native AOT, the same choice and for the same reason as the server: the trim/AOT
         analyzers then run on EVERY build, so an incompatible pattern fails at compile time
         rather than on a release runner. It matters more here than there — this binary starts
         once per terminal command, and start-up is the whole user-visible cost. -->
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <!-- No reflection-based JSON anywhere: every payload goes through the source-generated
         context in CredsJsonContext. This turns an accidental reflective call into an error. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The broker client, the contract and the WSL bridge — shared with `creds-mcp`, which
         speaks the same protocol to the same window. The wire contract is embedded THERE, once:
         two binaries each embedding their own copy of a generated specification is the drift
         the generated file exists to prevent, with extra steps. -->
    <ProjectReference Include="..\..\src_broker_client\src\BrokerClient.csproj" />
    <!-- The repository's one logging configuration (src_service_defaults): a coloured console on
         stderr and a file per serving run, the same sinks the server writes through. Its cost was
         MEASURED against a refusal criterion fixed in advance (> 3 MB or > 50 ms added to the first
         response would have meant a hand-written sink): +1.25 MiB (6.26 to 7.56 MB, win-x64), and nothing measurable on a one-shot verb, which never builds a logger, zero trim/AOT warnings and no
         IL2104 suppression needed (research/RESULTS_wsl_bridge_orphans.md, §7.2 section). -->
    <ProjectReference Include="..\..\src_service_defaults\src\CredsForDevs.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CredsCli.Tests" />
  </ItemGroup>

</Project>
