<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>CredVaultServer</RootNamespace>
    <!-- The test project drives the app in-process through WebApplicationFactory,
         which needs the generated entry point to be visible to it. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CredVaultServer.Tests" />
  </ItemGroup>

</Project>
