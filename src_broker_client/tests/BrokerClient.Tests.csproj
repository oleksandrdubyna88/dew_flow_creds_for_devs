<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <AssemblyName>CredsBroker.Tests</AssemblyName>
    <RootNamespace>CredsBroker.Tests</RootNamespace>
    <!-- The library forbids reflection-based JSON so AOT failures surface at compile time. The
         test project deserializes the same payloads through the same source-generated context,
         so it inherits the rule rather than testing a laxer configuration than ships. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit.v3 does not contribute an implicit using of its own. -->
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <!-- A crashed window's announcement and a port that counts connections, linked from src_service_defaults the way
         the CLI and MCP test projects link it, so the three walks share one definition. -->
    <Compile Include="..\..\src_service_defaults\tests\Support\StaleWindows.cs" Link="Support\StaleWindows.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\BrokerClient.csproj" />
  </ItemGroup>

</Project>
