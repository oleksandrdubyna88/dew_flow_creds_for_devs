{
  "name": "cred-ssh-manager",
  "displayName": "Cred SSH Manager",
  "description": "Multi-account credential manager with quick SSH connectivity. Passwords live in VS Code SecretStorage; per-profile AES-256-GCM encrypted NAS backups.",
  "version": "0.23.0",
  "//publisher": "PLACEHOLDER — create a publisher at https://marketplace.visualstudio.com/manage and put its id here before `vsce publish`. See docs/PUBLISHING.md.",
  "publisher": "set-your-publisher-id",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ssh",
    "credentials",
    "password manager",
    "secrets",
    "vault"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/oleksandrdubyna88/dew_flow_creds_for_devs.git",
    "directory": "src_vs_code"
  },
  "bugs": {
    "url": "https://github.com/oleksandrdubyna88/dew_flow_creds_for_devs/issues"
  },
  "homepage": "https://github.com/oleksandrdubyna88/dew_flow_creds_for_devs#readme",
  "galleryBanner": {
    "color": "#1F4E96",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "itest:server": "npm run compile && node scripts/server-transport-itest.cjs",
    "icon": "node scripts/generate-icon.mjs",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  },
  "contributes": {
    "configuration": {
      "title": "Cred SSH Manager",
      "properties": {
        "credSshManager.nasBackupPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Default vault **location**: either a folder for the encrypted `vault_<email>.enc` files (e.g. `/mnt/z/Backups`, `Z:\\Backups`, `\\\\NAS\\Vault`) **or** a Cred Vault Server URL (`https://vault.company.com`) — a URL switches that account to authenticated server sync."
        },
        "credSshManager.accountNasPaths": {
          "type": "object",
          "default": {},
          "additionalProperties": { "type": "string" },
          "markdownDescription": "Per-account vault location: maps an account **email** to a folder **or** a Cred Vault Server URL, e.g. `{ \"work@corp.com\": \"https://vault.corp.com\", \"me@gmail.com\": \"/mnt/home-nas/vault\" }`. Accounts without a mapping use `#credSshManager.nasBackupPath#`. Easiest way to set: right-click the account → *Set Sync Location…*"
        },
        "credSshManager.autoSync": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Automatically sync all profiles with the NAS (`#credSshManager.nasBackupPath#`): after every change, on startup, and on an interval. Changes from several machines are MERGED per node (newest edit wins; deletions propagate). Requires the same sync PIN on every machine (`Cred SSH: Set Sync PIN`)."
        },
        "credSshManager.autoSyncIntervalMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "markdownDescription": "How often auto-sync pulls the NAS files, in minutes."
        },
        "credSshManager.dbExtensions": {
          "type": "object",
          "default": {},
          "additionalProperties": { "type": "string" },
          "markdownDescription": "Per-DB-type extension override for the Connect action, e.g. `{ \"mysql\": \"cweijan.vscode-mysql-client2\" }`. When empty, the first installed candidate is used (Database Client, the Microsoft SQL/PostgreSQL extensions, MongoDB for VS Code, …)."
        },
        "credSshManager.googleClientId": {
          "type": "string",
          "default": "",
          "markdownDescription": "OAuth 2.0 client id of your **Desktop app** credential (Google Cloud Console → APIs & Services → Credentials). Required for \"Sign in with Google\". The client secret is prompted on first sign-in and kept in SecretStorage."
        }
      }
    },
    "colors": [
      {
        "id": "credSshManager.teamIcon",
        "description": "Team / people icons in the Cred SSH tree",
        "defaults": {
          "dark": "#3B6FB6",
          "light": "#1F4E96",
          "highContrast": "#5B8FD6",
          "highContrastLight": "#1F4E96"
        }
      },
      {
        "id": "credSshManager.folderIcon",
        "description": "Folder icons in the Cred SSH tree",
        "defaults": {
          "dark": "#D2691E",
          "light": "#B4551A",
          "highContrast": "#E8824A",
          "highContrastLight": "#B4551A"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "credSshManager",
