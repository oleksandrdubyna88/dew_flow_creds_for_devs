    "viewsWelcome": [
      {
        "view": "credSshManagerView",
        "contents": "Your SSH hosts and keys, VPN configs, databases, passwords and the commands nobody remembers — kept in the OS keychain, encrypted before anything leaves this machine.\n\n[Add an account](command:credSshManager.addAccount)\n\nAn account is how a tree gets its own vault, its own sync location and its own team. Everything works with no server and no network; point it at a folder later if you want your other machines to have it too.\n\n[Open the walkthrough](command:workbench.action.openWalkthrough?%22remsoftdev.creds-for-devs%23credsForDevs.start%22)"
      }
    ],
    "walkthroughs": [
      {
        "id": "credsForDevs.start",
        "title": "Get started with CredsForDevs",
        "description": "Put one credential in, use it without retyping it, and see what never leaves your machine.",
        "steps": [
          {
            "id": "account",
            "title": "Add an account",
            "description": "Everything hangs off an account: its own tree, its own vault, its own team. Microsoft and Google both work, and neither is required to store anything locally.\n[Add an account](command:credSshManager.addAccount)",
            "media": {
              "markdown": "media/walkthrough/account.md"
            },
            "completionEvents": [
              "onCommand:credSshManager.addAccount"
            ]
          },
          {
            "id": "entity",
            "title": "Add your first credential",
            "description": "An SSH host, a database, a VPN, a command you keep forgetting — or just a password. The form generates one for you if you would rather not invent it.\n[Add an entity](command:credSshManager.addEntity)",
            "media": {
              "markdown": "media/walkthrough/entity.md"
            },
            "completionEvents": [
              "onCommand:credSshManager.addEntity"
            ]
          },
          {
            "id": "use",
            "title": "Use it without retyping it",
            "description": "Connect over SSH with the stored password supplied through SSH_ASKPASS, serve a key from the agent so it never becomes a file, or run a command with creds:// references resolved into the child process only.\n[Go to a credential](command:credSshManager.quickOpen)",
            "media": {
              "markdown": "media/walkthrough/use.md"
            },
            "completionEvents": [
              "onCommand:credSshManager.connectSsh",
              "onCommand:credSshManager.quickOpen"
            ]
          },
          {
            "id": "protect",
            "title": "Decide how it is protected",
            "description": "Set a sync PIN to encrypt what leaves the machine, register a YubiKey to open the vault with a touch, and set the idle auto-lock.\n[Set a sync PIN](command:credSshManager.setSyncPin)",
            "media": {
              "markdown": "media/walkthrough/protect.md"
            },
            "completionEvents": [
              "onCommand:credSshManager.setSyncPin",
              "onCommand:credSshManager.addSecurityKey"
            ]
          }
        ]
      }
    ],
