  "name": "creds-for-devs",
  "displayName": "CredsForDevs",
  "description": "Credential manager for developers: SSH hosts, keys, VPN configs and database connections in VS Code. Secrets live in the OS keychain; optional end-to-end encrypted sync and team sharing through a self-hosted vault server.",
  "version": "0.23.0",
