  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ssh",
    "credentials",
    "password manager",
    "secrets",
    "vault"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/oleksandrdubyna88/dew_flow_creds_for_devs.git",
    "directory": "src_vs_code"
  },
  "bugs": {
    "url": "https://github.com/oleksandrdubyna88/dew_flow_creds_for_devs/issues"
  },
  "homepage": "https://github.com/oleksandrdubyna88/dew_flow_creds_for_devs#readme",
  "galleryBanner": {
    "color": "#1F4E96",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "itest:server": "npm run compile && node scripts/server-transport-itest.cjs",
    "icon": "node scripts/generate-icon.mjs",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
