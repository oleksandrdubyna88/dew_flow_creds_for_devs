# Everything here is excluded from the published .vsix.
# What ships: dist/*.js (the esbuild bundle of the tested out/), media/, package.json,
# README.md, CHANGELOG.md, LICENSE.

.vscode/**
.vscode-test/**

# TypeScript sources and their maps — the dist/ bundle is what runs.
src/**
**/*.map
tsconfig.json

# The unbundled compiler output: tests run against it, the bundle is built from it,
# and shipping it beside dist/ would double the extension.
out/**

# Build + repo tooling.
scripts/**
node_modules/**
package-lock.json
.gitignore
.eslintcache
*.vsix

# The generated icon's source script lives in scripts/ (excluded above); media/icon.png
# itself must ship, so media/ is deliberately NOT ignored.
