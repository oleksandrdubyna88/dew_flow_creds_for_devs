## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Visual Studio working folder
.vs/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# ---------------------------------------------------------------------------
# Node / TypeScript / VS Code extension (src_vs_code)
#
# The .NET section above already ignores [Bb]in/ and [Oo]bj/ everywhere, which
# is why this section only has to name what the TypeScript toolchain adds.
# ---------------------------------------------------------------------------

# Dependencies — restored by `npm ci` from package-lock.json, never committed
node_modules/
jspm_packages/
.pnp
.pnp.js

# TypeScript build output (tsconfig.json outDir) and incremental state
out/
dist/
build/
*.tsbuildinfo

# Packaged extension — a build artifact, rebuilt by `npm run package`.
# 41 of these were committed in the pre-monorepo checkout; never again.
*.vsix

# npm / yarn / pnpm diagnostics
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache

# Test + coverage output
coverage/
.nyc_output/
junit.xml

# Editor / OS noise that follows a Node checkout around
.vscode-test/
.DS_Store
Thumbs.db

# Local environment overrides (the .NET section ignores bare `.env`)
.env.local
.env.*.local

# ---------------------------------------------------------------------------
# Deployment secrets — NEVER commit these (see deploy/README.md)
# ---------------------------------------------------------------------------

# Operator-authored compose environment: contains the tenant id, the allowed
# domains, and (for the Local scheme) an HMAC signing key.
deploy/.env

# Certificates and ACME account material fetched by certbot at runtime.
# NOTE the -data suffix: deploy/certbot/ holds the committed entrypoint script, and
# ignoring that directory would silently drop it from the repository.
deploy/certbot-data/
deploy/data/
# Throwaway state of the local ACME issuance harness
deploy/acme-test/state/
deploy/logs/
deploy/backups/
deploy/.update-state

# Vault blobs written by a server run outside Docker (Vault__DataDir=./data)
src_minimalapi_server/**/data/

# Host logs: a folder per day, a file per run (.claude/rules/shared/common/logging-serilog.md)
logs/

# The .http suite's report and any tag-filtered tree the runner materialises. The suite itself is
# committed; what a run produces is not — and a report you did not just produce proves nothing.
.http-artifacts/
