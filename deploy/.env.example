# ---------------------------------------------------------------------------
# Cred Vault Server — deployment configuration
#
#   cp .env.example .env    then edit    then: docker compose up -d
#
# This file is the ONLY thing you configure. It is git-ignored; nothing here should
# ever be committed. Everything is read by docker-compose.yml and passed to the app
# as Vault__*/Auth__* environment variables (double underscore = config section).
# ---------------------------------------------------------------------------

# ===========================================================================
# 1. WHO MAY USE THIS SERVER
# ===========================================================================

# Comma-separated email domains allowed to sign in. This is your company boundary:
# a valid Microsoft/Google token from outside these domains gets 403.
# REQUIRED — the server refuses to start without it (or ALLOW_ANY_DOMAIN=true).
ALLOWED_DOMAINS=example.com

# Set true ONLY if you genuinely want any verified Microsoft/Google account on earth
# to be able to store a vault here. There is no second gate behind this.
ALLOW_ANY_DOMAIN=false

# ===========================================================================
# 2. IDENTITY PROVIDER
#
# At least one of the three schemes below must be configured or the server refuses
# to start (it would otherwise 401 every request and look like a network fault).
# ===========================================================================

# --- Microsoft Entra ---
# Your tenant id (GUID) or domain. Enables Microsoft tokens.
MS_TENANT=

# Comma-separated accepted audiences. Leave EMPTY until the extension has its own app
# registration: an access token minted for Microsoft Graph carries Graph's audience, so
# audience validation would reject every real token. Issuer + domain + per-email scoping
# still apply meanwhile, but read the audience note in the server README before shipping.
MS_AUDIENCES=

# --- Google ---
GOOGLE_ENABLED=false
GOOGLE_AUDIENCES=

# --- Local HMAC scheme (offline / air-gapped / smoke tests) ---
# A shared symmetric key that mints tokens without any cloud IdP. Anyone holding this
# string can impersonate ANY email in ALLOWED_DOMAINS. Leave EMPTY in any deployment
# that has a real identity provider. If you do use it, generate it with:
#   openssl rand -base64 48
LOCAL_SIGNING_KEY=

# ===========================================================================
# 3. TLS
#
# TLS_MODE picks how certificates are obtained. Read the table in README.md before
# choosing — the wrong mode for your network is the single most common way this
# deployment fails to come up.
#
#   domain — Let's Encrypt via HTTP-01. Needs public DNS for DOMAIN pointing here and
#            port 80 reachable from the internet. The normal choice.
#   ip     — Let's Encrypt for a bare PUBLIC IP. Certificates are ~6 days by policy, so
#            the renewal loop is load-bearing. Only works for a PUBLIC, internet-reachable
#            address; 10.x / 172.16-31.x / 192.168.x can never be validated.
#   custom — you provide the certificate. Put fullchain.pem + privkey.pem in
#            ${CERT_DIR}/conf/live/custom/. Use this for an internal CA or a wildcard.
#   none   — plain HTTP, no TLS at all. Only when something else already terminates TLS
#            in front of this stack.
#
# NOTE FOR INTERNAL DEPLOYMENTS: the VS Code extension uses fetch() with no certificate
# override, so it REJECTS a self-signed certificate outright. On an internal network the
# working options are (a) a real domain whose certificate you obtain by DNS-01 elsewhere
# and drop in via TLS_MODE=custom, or (b) an internal CA already installed in every
# workstation's OS trust store. A bare self-signed certificate will not work.
# ===========================================================================

TLS_MODE=domain

# For TLS_MODE=domain
DOMAIN=vault.example.com

# For TLS_MODE=ip — must be a PUBLIC address
PUBLIC_IP=

# Where expiry warnings go. Strongly recommended; leave empty to register anonymously.
ACME_EMAIL=

# Set true to hit the Let's Encrypt staging CA while you get the setup right. Staging
# certificates are NOT trusted by clients, but the rate limits are far more forgiving —
# use it for the first attempt, then set back to false and delete ${CERT_DIR}/conf.
ACME_STAGING=false

# How often the renewal loop wakes (seconds). 21600 = 6h. Do not raise this above
# ~43200 on TLS_MODE=ip: those certificates only live about six days.
RENEW_INTERVAL_SECONDS=21600

# Refuse any request that did not arrive through the TLS proxy. Keep true unless
# TLS_MODE=none, in which case it must be false or every request gets 403.
REQUIRE_HTTPS=true

HSTS_MAX_AGE=31536000

# ===========================================================================
# 4. PERSISTENCE — the paths that survive an update
#
# These are bind mounts on the host. `./update.sh` replaces containers and images;
# it never touches these directories. Point them at real storage you back up.
# ===========================================================================

DATA_DIR=./data
CERT_DIR=./certbot-data
LOG_DIR=./logs

# ===========================================================================
# 5. BACKUPS — pick a path, pick how often
#
# The server backs itself up to ONE directory on a schedule. That directory is
# the only thing it knows about, so it can be anything the host can mount or
# sync: a NAS share, an rclone mount, a Google Drive or OneDrive sync folder, an
# external disk. No cloud credentials and no provider-specific setup.
#
# Each run writes a single verified .tar.gz and prunes old ones. A run that finds
# nothing changed since the last one skips writing entirely, so a daily backup of
# a quiet vault does not re-upload the same bytes to a metered folder every day.
# ===========================================================================

# Where the archives go. THIS is the setting you came here for.
#   ./backups                     beside the deployment (default)
#   /mnt/nas/vault                a mounted NAS share
#   /home/me/OneDrive/vault       a cloud sync folder — the client uploads it
#   /mnt/gdrive/vault             an rclone mount
BACKUP_DIR=./backups

# How often, in whole hours. 24 = daily, 168 = weekly, 1 = hourly.
BACKUP_INTERVAL_HOURS=24

# Take one immediately on startup, so a wrong path is discovered now rather than
# tomorrow — or during a restore.
BACKUP_ON_START=true

# Delete archives older than this. 0 keeps them forever. Retention will never
# delete the LAST remaining backup, whatever its age.
BACKUP_RETAIN_DAYS=30

# Skip writing when nothing changed since the previous archive.
BACKUP_SKIP_IF_UNCHANGED=true

# NOTE: the scheduled backup contains the vault data and the certificates. It
# does NOT contain this .env file, because it holds LOCAL_SIGNING_KEY and the
# destination is often a cloud folder — copying a signing key there should be
# your decision, not a side effect of enabling backups. Keep .env wherever you
# keep secrets. The vault blobs themselves are ciphertext the server cannot read.

# ===========================================================================
# 6. IMAGE + UPDATES
# ===========================================================================

# Images are published to the GitHub Container Registry (ghcr.io) by CI:
#
#   :edge          every push to main — tested, but moving. Good for a trial.
#   :sha-<commit>  immutable, one per commit.
#   :1.4.0         a real release, from a `server-v1.4.0` tag.
#   :latest        moves ONLY on a release tag, never on an ordinary commit.
#
# Pin a version tag in production, so an update is a decision you make rather than one
# you discover. ./update.sh reads this value and rewrites it when you pass a version.
#
# NOTE: a ghcr package is PRIVATE until its owner makes it public. If `docker compose
# up -d` fails with "denied" or "manifest unknown", either mark the package public
# (GitHub -> Packages -> cred-vault-server -> Package settings -> Change visibility),
# or log in first:
#   echo <a GitHub PAT with read:packages> | docker login ghcr.io -u <username> --password-stdin
VAULT_IMAGE=ghcr.io/oleksandrdubyna88/cred-vault-server:0.2.1

# ===========================================================================
# 7. LIMITS AND TUNING (safe defaults — change only with a reason)
# ===========================================================================

HTTP_PORT=80
HTTPS_PORT=443

# Per-vault upload cap in bytes (8 MiB). MAX_BODY_MB is nginx's ceiling and must stay
# comfortably above it.
MAX_VAULT_BYTES=8388608
MAX_BODY_MB=16

# Per-share payload cap (1 MiB) and how many pending shares one inbox may hold.
# MAX_SHARE_BYTES x MAX_INBOX_ITEMS is the worst case one recipient can be sent.
MAX_SHARE_BYTES=1048576
MAX_INBOX_ITEMS=500

# Per-authenticated-caller request budget. Anonymous requests share a per-IP bucket.
RATE_LIMIT_PERMITS=120
RATE_LIMIT_WINDOW_SECONDS=10

VAULT_MEMORY_LIMIT=512m

# Ceilings for the edge. nginx is the only container with ports on 0.0.0.0, so it is
# the one whose absence of a limit could take the host down with it.
NGINX_MEMORY_LIMIT=128m
NGINX_CPU_LIMIT=1.0

# The certificate container, pinned rather than :latest. Raise it deliberately; the
# floor is 5.4, which is what --ip-address with --webroot needs.
CERTBOT_IMAGE=certbot/certbot:v5.7.0
CERTBOT_MEMORY_LIMIT=128m

# Verbosity: Verbose | Debug | Information | Warning | Error | Fatal
LOG_LEVEL=Information
