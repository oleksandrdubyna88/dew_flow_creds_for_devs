{
  "$comment": "GENERATED by src_vs_code/scripts/emit-contract.mjs from brokerProtocol.ts and agentCliOutcome.ts. Do not edit by hand: a test on each side asserts its own tables match this file, so an edit here without the code change turns both of them red.",
  "version": 1,
  "service": "creds-for-devs-agent",
  "health": {
    "method": "GET",
    "path": "/v1/health",
    "authenticated": false
  },
  "limits": {
    "maxRequestBodyBytes": 65536,
    "maxStreamBytes": 262144,
    "maxConcurrentExecs": 8,
    "defaultExecTimeoutMs": 30000,
    "minExecTimeoutMs": 1000,
    "maxExecTimeoutMs": 120000
  },
  "routes": {
    "exec": "/v1/use/exec",
    "terminal": "/v1/use/terminal",
    "db": "/v1/use/query",
    "run": "/v1/use/run",
    "script": "/v1/use/run",
    "env": "/v1/use/exportEnv",
    "vpn-up": "/v1/use/up",
    "vpn-down": "/v1/use/down"
  },
  "reads": {
    "aliases": "/v1/aliases",
    "mcpEntries": "/v1/mcp/entries"
  },
  "mcpUsePrefix": "/v1/mcp/use/",
  "mcpDeleteRoute": "/v1/mcp/delete",
  "mcpCreateRoute": "/v1/mcp/create",
  "mcpActions": [
    "exec",
    "terminal",
    "query",
    "run",
    "exportEnv",
    "up",
    "down",
    "rotate"
  ],
  "errors": {
    "invalid_request": 400,
    "unauthorized": 401,
    "denied": 403,
    "not_found": 404,
    "not_supported": 404,
    "no_credential": 409,
    "payload_too_large": 413,
    "too_many_requests": 429,
    "consent_timeout": 504,
    "tool_missing": 412,
    "internal": 500
  },
  "exitCodes": {
    "usage": 96,
    "brokerUnreachable": 90,
    "unknownToken": 91,
    "denied": 92,
    "entityGone": 93,
    "busy": 94,
    "brokerFailure": 95,
    "consentTimeout": 97,
    "remoteTimeout": 98,
    "toolMissing": 99,
    "refused": 89
  }
}
