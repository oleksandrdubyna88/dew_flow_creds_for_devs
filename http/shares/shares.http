###
# The sealed fields must be base64 — the server never decodes them, but a payload it cannot even
# store is refused at the door rather than handed to a recipient who cannot open it.
# @name share_with_a_payload_that_is_not_base64_is_400
POST {{baseUrl}}/api/shares
Authorization: Bearer {{token}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{
  "toEmail": "{{bobEmail}}",
  "entityName": "staging database",
  "salt": "AAAAAAAAAAAAAAAAAAAAAA==",
  "iv": "AAAAAAAAAAAAAAAA",
  "tag": "AAAAAAAAAAAAAAAAAAAAAA==",
  "data": "not base64 at all !!"
}

?? status == 400

###
# @name share_post_a_third_time_so_the_outcome_paths_have_something_to_take
POST {{baseUrl}}/api/shares
Authorization: Bearer {{token}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{
  "toEmail": "{{bobEmail}}",
  "entityName": "a third share",
  "entityKind": "credential",
  "salt": "c2FsdHNhbHRzYWx0c2FsdA==",
  "iv": "aXZpdml2aXZpdml2aQ==",
  "tag": "dGFndGFndGFndGFndGFndGFn",
  "data": "ZW5jcnlwdGVkLXBheWxvYWQ="
}

?? status == 201

###
# @name shares_finds_the_third_one
GET {{baseUrl}}/api/shares
Authorization: Bearer {{bobToken}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 200

{{
  const assert = require('node:assert');
  const third = response.parsedBody.find((s) => s.entityName === 'a third share');
  test('the third share is in the inbox', () => {
    assert.ok(third, 'the share posted above is not in the inbox');
  });
  exports.thirdShareId = third.id;
}}

###
# An outcome this server has no kind for — a NEWER client, or a typo — is recorded as unknown and the
# share is still deleted. A 400 here would break an inbox over a log field.
# @name deleting_with_an_outcome_this_server_does_not_know_is_still_204
DELETE {{baseUrl}}/api/shares/{{thirdShareId}}?outcome=forwarded-to-legal
Authorization: Bearer {{bobToken}}
X-Creds-Contract: {{contract}}

?? status == 204

###
# @name share_post_a_fourth_time_for_the_delete_that_says_nothing
POST {{baseUrl}}/api/shares
Authorization: Bearer {{token}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{
  "toEmail": "{{bobEmail}}",
  "entityName": "a fourth share",
  "entityKind": "credential",
  "salt": "c2FsdHNhbHRzYWx0c2FsdA==",
  "iv": "aXZpdml2aXZpdml2aQ==",
  "tag": "dGFndGFndGFndGFndGFndGFn",
  "data": "ZW5jcnlwdGVkLXBheWxvYWQ="
}

?? status == 201

###
# @name shares_finds_the_fourth_one
GET {{baseUrl}}/api/shares
Authorization: Bearer {{bobToken}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 200

{{
  const assert = require('node:assert');
  const fourth = response.parsedBody.find((s) => s.entityName === 'a fourth share');
  test('the fourth share is in the inbox', () => {
    assert.ok(fourth, 'the share posted above is not in the inbox');
  });
  exports.fourthShareId = fourth.id;
}}

###
# And a delete that says NOTHING: the shape every released client sends. It deletes, and the log
# records that the server was not told which it was, rather than inventing an answer.
# @name deleting_without_saying_which_is_still_204
DELETE {{baseUrl}}/api/shares/{{fourthShareId}}
Authorization: Bearer {{bobToken}}
X-Creds-Contract: {{contract}}

?? status == 204

###
# @name deleting_a_share_that_is_not_in_your_inbox_is_404
DELETE {{baseUrl}}/api/shares/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{bobToken}}
X-Creds-Contract: {{contract}}

?? status == 404

###
# @name withdrawing_a_share_you_never_sent_is_404
DELETE {{baseUrl}}/api/shares/sent/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}
X-Creds-Contract: {{contract}}

?? status == 404

###
# @name posting_a_share_without_a_token_is_401
POST {{baseUrl}}/api/shares
Content-Type: application/json

{ "toEmail": "someone@example.com", "entityName": "x", "salt": "AAAA", "iv": "AAAA", "tag": "AAAA", "data": "AAAA" }

?? status == 401

###

# ----- epic 3: the project rule -----
#
# The one boundary of the project epic the server enforces rather than asks an honest client to obey.
# It fences DEVELOPERS only; a member's share is untouched, which every request above this line is.
# Alice becomes a developer for two requests and is put back — a file that changes a role and does
# not restore it leaves every later file running against a different server than it expects.

# @name shares_makes_alice_a_developer
PUT {{baseUrl}}/api/org/members/{{aliceEmail}}
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "role": "dev" }

?? status == 200
?? header content-type matches ^application\/json

{{
  const assert = require('node:assert');
  test('she is a developer for the next two requests', () => {
    assert.strictEqual(response.parsedBody.role, 'dev');
  });
}}

###

# @name shares_a_developer_may_not_share_from_outside_a_project
POST {{baseUrl}}/api/shares
Authorization: Bearer {{token}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "toEmail": "{{bobEmail}}", "entityName": "prod db", "entityKind": "db",
  "salt": "AAAAAAAAAAAAAAAAAAAAAA==", "iv": "AAAAAAAAAAAAAAAA", "tag": "AAAAAAAAAAAAAAAAAAAAAA==",
  "data": "c2VhbGVk" }

?? status == 403

{{
  const assert = require('node:assert');
  test('the refusal says what to do about it, not merely that it was refused', () => {
    assert.match(response.body, /project folder/);
  });
}}

###

# @name shares_a_developer_naming_a_project_that_is_not_there_is_403
POST {{baseUrl}}/api/shares
Authorization: Bearer {{token}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "toEmail": "{{bobEmail}}", "entityName": "prod db", "entityKind": "db",
  "salt": "AAAAAAAAAAAAAAAAAAAAAA==", "iv": "AAAAAAAAAAAAAAAA", "tag": "AAAAAAAAAAAAAAAAAAAAAA==",
  "data": "c2VhbGVk", "projectId": "00000000000000000000000000000000" }

?? status == 403

{{
  const assert = require('node:assert');
  test('a project that is gone or closed is not a channel', () => {
    assert.match(response.body, /not available/);
  });
}}

###

# @name shares_puts_alice_back
PUT {{baseUrl}}/api/org/members/{{aliceEmail}}
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "role": "member" }

?? status == 200
?? header content-type matches ^application\/json

{{
  const assert = require('node:assert');
  test('and she is a member again, or every later file runs against a different server', () => {
    assert.strictEqual(response.parsedBody.role, 'member');
  });
}}
###
# @uncovered the event ROWS these requests leave — share.sent, share.accepted, share.unknown,
#            share.withdrawn, share.withdrawn_blocked, share.expired and login_key.issued. A row is
#            not a response: it is a line in a file on the server, and the only wire-visible half is
#            GET /api/org/events, which http/org/events.http exercises. ShareEventRowTests asserts
#            every kind by reading the row back out of the log, including that no byte of a share's
#            sealed payload reaches it.
# @uncovered 409 inbox full — the cap is 500 pending items per recipient. Filling an inbox to
#            provoke it is 500 requests and leaves a store nothing in this file can clean up.
# @uncovered 400 payload too large — the cap is 1 MiB; sending it asserts a number in a config file
#            rather than a behaviour, and slowly.
# @uncovered the developer rule's remaining rows — a share INSIDE a project, one to somebody off
#            it, an assignment set to no sharing, an archived project, and the 503 for a project
#            file this build cannot read. Each needs a project, two assignments and a role flip
#            against accounts the rest of this suite shares; OrgProjectShareTests covers all five
#            over real HTTP and asserts what a status code cannot — that a refused share leaves no
#            inbox and no receipt behind.
