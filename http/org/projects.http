# Bob becomes a developer for the two requests below, and is put back afterwards.
# @name org_projects_makes_bob_a_developer
PUT {{baseUrl}}/api/org/members/{{bobEmail}}
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "role": "dev" }

?? status == 200
?? header content-type matches ^application\/json

{{
  const assert = require('node:assert');
  test('the answer is his row, carrying the role it now holds', () => {
    assert.strictEqual(response.parsedBody.email, bobEmail);
    assert.strictEqual(response.parsedBody.role, 'dev');
  });
}}

