# Projects — the admin's six routes under /api/org/projects, and the person's own acknowledgement.
#
# A project is a name people are assigned to. The assignment is what epic 3's later stories turn into
# a folder in that person's vault and into a share rule; this file covers the surface that creates
# them, and the two refusals that are decisions rather than typos:
#
#   * `deleteFolder` is REQUIRED on an unassignment. Left to a default, one reading deletes somebody's
#     folder when the admin meant only to unassign and the other leaves corporate material on a machine
#     when they meant to remove it — and the request looks identical either way.
#   * a rename does NOT unarchive. `archived` omitted means "leave it", never `false`.
#
# PRECONDITION: a corp-mode server (../README.md — three officers). `{{officerToken}}` administers;
# `{{token}}` (Alice) and `{{bobToken}}` do not.
#
# THE SUITE HAS NO DEVELOPER, so the dev-only visibility rule is exercised by making Bob one for two
# requests and putting him back. Said here because a file that changes a role and does not restore it
# leaves every later file running against a different server than it expects.
#
# The file archives what it creates at the end: a project cannot be deleted (the event log cites it),
# so a completed run leaves the store with one archived project rather than a growing list of live ones.

# @name org_projects_creates_one
POST {{baseUrl}}/api/org/projects
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "name": "Atlas" }

?? status == 200
?? header content-type matches ^application\/json

{{
  const assert = require('node:assert');
  test('the answer names the project and gives it an id', () => {
    assert.match(response.parsedBody.id, /^[0-9a-f]{32}$/);
    assert.strictEqual(response.parsedBody.name, 'Atlas');
    assert.strictEqual(response.parsedBody.archived, false);
  });
  exports.projectId = response.parsedBody.id;
}}

###

# @name org_projects_refuses_a_nameless_one
POST {{baseUrl}}/api/org/projects
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "name": "   " }

?? status == 400

###

# @name org_projects_refuses_a_caller_who_does_not_administer
POST {{baseUrl}}/api/org/projects
Authorization: Bearer {{token}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "name": "Sneaky" }

?? status == 403

###

# @name org_projects_renames_without_unarchiving
PUT {{baseUrl}}/api/org/projects/{{projectId}}
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "name": "Atlas II" }

?? status == 200

{{
  const assert = require('node:assert');
  test('the rename lands and the project is still live', () => {
    assert.strictEqual(response.parsedBody.name, 'Atlas II');
    assert.strictEqual(response.parsedBody.archived, false);
  });
}}

###

# @name org_projects_refuses_an_empty_change
PUT {{baseUrl}}/api/org/projects/{{projectId}}
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{}

?? status == 400

###

# @name org_projects_assigns_bob
PUT {{baseUrl}}/api/org/projects/{{projectId}}/members/{{bobEmail}}
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "share": "project" }

?? status == 204

###

# @name org_projects_show_up_on_his_own_document
GET {{baseUrl}}/api/org/me
Authorization: Bearer {{bobToken}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 200

{{
  const assert = require('node:assert');
  test('his own document names the project rather than only its id', () => {
    const mine = response.parsedBody.projects.find((p) => p.projectId === projectId);
    assert.ok(mine, 'the assignment is on his record');
    assert.strictEqual(mine.name, 'Atlas II');
    assert.strictEqual(mine.share, 'project');
  });
}}

