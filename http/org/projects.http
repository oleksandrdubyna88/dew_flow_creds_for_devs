?? status == 200

{{
  const assert = require('node:assert');
  test('every project a developer can see is one they are on', () => {
    assert.ok(response.parsedBody.every((p) => p.id === projectId),
      'a project name is a fact about a customer engagement, not a directory');
  });
}}

