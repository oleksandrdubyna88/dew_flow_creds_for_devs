# @name org_projects_refuses_a_project_that_does_not_exist
PUT {{baseUrl}}/api/org/projects/00000000000000000000000000000000/members/{{bobEmail}}
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "share": "inherit" }

