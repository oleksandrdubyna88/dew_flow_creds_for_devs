# @name org_projects_an_archived_project_takes_nobody_new
PUT {{baseUrl}}/api/org/projects/{{projectId}}/members/{{bobEmail}}
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "share": "project" }

?? status == 409
?? header content-type matches ^application\/json

{{
  const assert = require('node:assert');
  test('archiving is how a project closes, and a closed one takes no new people', () => {
    assert.match(response.parsedBody.error, /archived/);
  });
}}

###
# @uncovered 503 — a project file this build cannot read, and a member record it cannot read: both
#            need a file corrupted underneath a running server, which is machinery this tier does not
#            ask for. OrgProjectsStoreTests writes the garbage and reads the three-answer result back;
#            OrgProjectsAdminTests covers the 503 the admin routes answer over it.
# @uncovered 401 on the five routes other than GET /api/org/projects — the token gate is shared by
#            every corporate route and runs before any of them, so one request proves it for the
#            group rather than six requests proving the same gate six times.
