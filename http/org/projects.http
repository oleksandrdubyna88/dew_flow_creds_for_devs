# @name org_projects_refuses_an_officer_target
PUT {{baseUrl}}/api/org/projects/{{projectId}}/members/officer2@example.com
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "share": "inherit" }

?? status == 409

