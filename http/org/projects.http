# Bob becomes a developer for the two requests below, and is put back afterwards.
# @name org_projects_makes_bob_a_developer
PUT {{baseUrl}}/api/org/members/{{bobEmail}}
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "role": "dev" }

?? status == 200

###

# @name org_projects_a_developer_sees_only_their_own
GET {{baseUrl}}/api/org/projects
Authorization: Bearer {{bobToken}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 200

{{
  const assert = require('node:assert');
  test('every project a developer can see is one they are on', () => {
    assert.ok(response.parsedBody.every((p) => p.id === projectId),
      'a project name is a fact about a customer engagement, not a directory');
  });
}}

###

# @name org_projects_puts_bob_back
PUT {{baseUrl}}/api/org/members/{{bobEmail}}
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "role": "member" }

?? status == 200

###

# @name org_projects_unassignment_must_say_what_happens_to_the_folder
DELETE {{baseUrl}}/api/org/projects/{{projectId}}/members/{{bobEmail}}
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}

?? status == 400

{{
  const assert = require('node:assert');
  test('the refusal says what to send and why there is no default', () => {
    assert.match(response.parsedBody.error, /deleteFolder/);
  });
}}

###

# @name org_projects_unassigns_and_asks_for_the_folder_back
DELETE {{baseUrl}}/api/org/projects/{{projectId}}/members/{{bobEmail}}?deleteFolder=true
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}

?? status == 204

###

# @name org_projects_the_instruction_reaches_him
GET {{baseUrl}}/api/org/me
Authorization: Bearer {{bobToken}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 200

{{
  const assert = require('node:assert');
  test('the removal is on his own document, which is how his client will find it', () => {
    const pending = response.parsedBody.pendingFolderRemovals.find((p) => p.projectId === projectId);
    assert.ok(pending, 'the instruction is durable, not an event that can be missed');
    assert.strictEqual(pending.deleteFolder, true);
  });
  test('and the assignment is gone', () => {
    assert.strictEqual(response.parsedBody.projects.find((p) => p.projectId === projectId), undefined);
  });
}}

###

# @name org_projects_he_acknowledges_it
POST {{baseUrl}}/api/org/members/me/pending-folder-removals/{{projectId}}/ack
Authorization: Bearer {{bobToken}}
X-Creds-Contract: {{contract}}

?? status == 204

###

# @name org_projects_acknowledging_twice_is_still_204
POST {{baseUrl}}/api/org/members/me/pending-folder-removals/{{projectId}}/ack
Authorization: Bearer {{bobToken}}
X-Creds-Contract: {{contract}}

?? status == 204

###

# @name org_projects_the_instruction_is_gone
GET {{baseUrl}}/api/org/me
Authorization: Bearer {{bobToken}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 200

{{
  const assert = require('node:assert');
  test('cleared once, and only that one', () => {
    assert.strictEqual(response.parsedBody.pendingFolderRemovals.length, 0);
  });
}}

###

# @name org_projects_archives_what_this_file_created
PUT {{baseUrl}}/api/org/projects/{{projectId}}
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "archived": true }

?? status == 200

{{
  const assert = require('node:assert');
  test('a project is archived, never deleted — the event log cites it by id forever', () => {
    assert.strictEqual(response.parsedBody.archived, true);
  });
}}

###
# @uncovered 503 — a project file this build cannot read, and a member record it cannot read: both
#            need a file corrupted underneath a running server, which is machinery this tier does not
#            ask for. OrgProjectsStoreTests writes the garbage and reads the three-answer result back;
#            OrgProjectsAdminTests covers the 503 the admin routes answer over it.
