# @name org_members_refuses_a_role_it_does_not_know
PUT {{baseUrl}}/api/org/members/{{aliceEmail}}
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json
Accept: application/json

{ "role": "superuser" }

?? status == 400
?? header content-type matches ^application\/json

{{
  const assert = require('node:assert');
  test('the 400 names the legal values — the sentence is for an admin UI, not a log', () => {
    assert.match(response.parsedBody.error, /admin/);
    assert.match(response.parsedBody.error, /member/);
    assert.match(response.parsedBody.error, /dev/);
  });
}}

