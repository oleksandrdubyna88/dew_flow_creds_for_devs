# @name org_members_refuses_an_officer_target
PUT {{baseUrl}}/api/org/members/{{officerEmail}}
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json
Accept: application/json

{ "role": "member" }

?? status == 409
?? header content-type matches ^application\/json

{{
  const assert = require('node:assert');
  test('409, not a silent no-op: a UI that appeared to demote an officer would be lying', () => {
    assert.match(response.parsedBody.error, /officer/i);
  });
}}

###

# @name org_members_puts_the_target_back_to_member
PUT {{baseUrl}}/api/org/members/{{aliceEmail}}
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json
Accept: application/json

{ "role": "member", "shareDefault": "project" }

?? status == 200

{{
  const assert = require('node:assert');
  test('the roster is as the run found it', () => {
    assert.strictEqual(response.parsedBody.role, 'member');
    assert.strictEqual(response.parsedBody.shareDefault, 'project');
  });
}}

