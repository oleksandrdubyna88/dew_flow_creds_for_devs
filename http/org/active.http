# Blocking — PUT /api/org/members/{email}/active, admin-only. `{active: false}` shuts every door the same
# minute: the caller gate inside RequireCaller refuses the person on their very next request with a 403
# carrying `X-Creds-Reason: account-deactivated` (so a client can tell it from a domain 403 without
# matching prose), every pending share to and from them is withdrawn, and the sender of a withdrawn share
# is told why on their receipt, once, then dismisses it. `{active: true}` re-admits. Idempotent: 204
# whether or not anything changed.
#
# PRECONDITION: a corp-mode server (../README.md — three officers). `{{officerToken}}` administers;
# `{{token}}` (Alice) and `{{bobToken}}` do not.
#
# The file blocks Alice and then Bob, and the last requests put both back, so a completed run leaves the
# roster as it found it — and every share it posts is withdrawn and dismissed before the end, so
# shares/shares.http still finds an empty store.

# @name org_active_blocks_a_person
PUT {{baseUrl}}/api/org/members/{{aliceEmail}}/active
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "active": false }

?? status == 204

###

# @name org_active_shows_in_the_roster
GET {{baseUrl}}/api/org/members
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 200
?? header content-type matches ^application\/json

{{
  const assert = require('node:assert');
  test('the row says inactive, as a boolean an admin UI can draw a badge from', () => {
    const alice = response.parsedBody.find((row) => row.email === aliceEmail);
    assert.ok(alice, 'Alice has a record — the block created or updated it');
    assert.strictEqual(alice.active, false);
    assert.strictEqual(alice.updatedBy, officerEmail, 'stamped from the token');
  });
}}

###
# The gate, on an OLD route: the plain 403 plus the header. No body here — the older routes answer their
# 401 and 403 with none, and this refusal keeps their shape.
# @name org_active_the_blocked_person_is_refused_with_a_reason_header
GET {{baseUrl}}/api/vault
Authorization: Bearer {{token}}
X-Creds-Contract: {{contract}}

?? status == 403
?? header x-creds-reason == account-deactivated

###
# The same gate on the corporate surface: the JSON {error} that surface promises, and the same header.
# @name org_active_the_blocked_person_is_refused_on_the_corporate_surface_with_json
GET {{baseUrl}}/api/org/me
Authorization: Bearer {{token}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 403
?? header content-type matches ^application\/json
?? header x-creds-reason == account-deactivated

{{
  const assert = require('node:assert');
  test('the body says it is a deactivation, not a domain refusal', () => {
    assert.match(response.parsedBody.error, /deactivated/i);
  });
}}

###
# @name org_active_blocking_twice_is_idempotent
PUT {{baseUrl}}/api/org/members/{{aliceEmail}}/active
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "active": false }

?? status == 204

###
# `active` is nullable on purpose: a deserializer runs no defaults, a positional bool omitted by the
# client binds to false, and false here BLOCKS somebody. `{}` is a 400 that names the field.
# @name org_active_refuses_a_body_with_no_field
PUT {{baseUrl}}/api/org/members/{{aliceEmail}}/active
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json
Accept: application/json

{}

?? status == 400
?? header content-type matches ^application\/json

{{
  const assert = require('node:assert');
  test('an omitted field is a 400 naming it, never a false the deserializer invented', () => {
    assert.match(response.parsedBody.error, /active/);
  });
}}

###

