# @name org_active_puts_the_person_back
PUT {{baseUrl}}/api/org/members/{{aliceEmail}}/active
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "active": true }

?? status == 204

###

# @name org_active_the_restored_person_is_served_again
GET {{baseUrl}}/api/org/me
Authorization: Bearer {{token}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 200

{{
  const assert = require('node:assert');
  test('reversible — decision 5: active again, and no reason header on a success', () => {
    assert.strictEqual(response.parsedBody.active, true);
    assert.strictEqual(response.headers['x-creds-reason'], undefined);
  });
}}

###
# ----- withdrawal: what a block does to a share that was pending -----
# Alice shares with Bob; Bob is blocked; the share leaves Bob's inbox and Alice's receipt carries the
# reason — rewritten, not deleted, because the receipt is the only place she can learn why. Then she
# dismisses it, which is the new first branch of DELETE /api/shares/sent/{id}: 204 whatever the inbox says
# (the older branch would read the missing inbox file as "already accepted" and answer 409).

# @name org_active_a_share_is_posted_so_the_block_has_something_to_withdraw
POST {{baseUrl}}/api/shares
Authorization: Bearer {{token}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{
  "toEmail": "{{bobEmail}}",
  "entityName": "withdrawn by a block",
  "entityKind": "credential",
  "salt": "AAAAAAAAAAAAAAAAAAAAAA==",
  "iv": "AAAAAAAAAAAAAAAA",
  "tag": "AAAAAAAAAAAAAAAAAAAAAA==",
  "data": "c2VhbGVkLWJ5dGVz"
}

?? status == 201

###

# @name org_active_blocks_the_recipient
PUT {{baseUrl}}/api/org/members/{{bobEmail}}/active
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "active": false }

?? status == 204

###

# The recipient half of the rule: a blocked person is hidden from /api/team, not from a client that
# remembers the address — and a share that landed anyway would wait in an inbox nobody can open until the
# day they are re-admitted. The refusal carries NO X-Creds-Reason: that header tells a client to lock its
# OWN account, and this response is about somebody else's standing.
# @name org_active_a_share_to_the_blocked_recipient_is_refused
POST {{baseUrl}}/api/shares
Authorization: Bearer {{token}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{
  "toEmail": "{{bobEmail}}",
  "entityName": "sent after the block",
  "entityKind": "db",
  "salt": "AAAAAAAAAAAAAAAAAAAAAA==",
  "iv": "AAAAAAAAAAAAAAAA",
  "tag": "AAAAAAAAAAAAAAAAAAAAAA==",
  "data": "c2VhbGVkLXBheWxvYWQ="
}

?? status == 403

{{
  const assert = require('node:assert');
  test('the sentence names the reason, and no header tells the sender to lock their own vault', () => {
    assert.match(response.body, /deactivated/i);
    assert.strictEqual(response.headers['x-creds-reason'], undefined);
  });
}}

###

# @name org_active_the_senders_receipt_carries_the_reason
GET {{baseUrl}}/api/shares/sent
Authorization: Bearer {{token}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 200
?? header content-type matches ^application\/json

{{
  const assert = require('node:assert');
  const receipts = response.parsedBody;
  test('exactly the one receipt this run created — a leftover means an earlier run did not finish', () => {
    assert.ok(Array.isArray(receipts));
    assert.strictEqual(receipts.length, 1, `expected 1 receipt, found ${receipts.length}`);
  });
  test('the receipt is kept and says why: withdrawnReason is a non-empty string', () => {
    assert.strictEqual(typeof receipts[0].withdrawnReason, 'string');
    assert.ok(receipts[0].withdrawnReason.length > 0);
    assert.match(receipts[0].withdrawnReason, /deactivated/i);
  });
  test('and it is still a receipt, never a copy of the secret', () => {
    for (const secret of ['salt', 'iv', 'tag', 'data']) {
      assert.ok(!(secret in receipts[0]));
    }
  });
  exports.withdrawnShareId = receipts[0].id;
}}

###

# @name org_active_dismissing_a_withdrawn_receipt_is_204
DELETE {{baseUrl}}/api/shares/sent/{{withdrawnShareId}}
Authorization: Bearer {{token}}
X-Creds-Contract: {{contract}}

?? status == 204

###

# @name org_active_the_dismissed_receipt_is_gone
GET {{baseUrl}}/api/shares/sent
Authorization: Bearer {{token}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 200

{{
  const assert = require('node:assert');
  test('dismissed once, gone — the store is as the run found it', () => {
    assert.strictEqual(response.parsedBody.length, 0);
  });
}}

###

# @name org_active_puts_the_recipient_back
PUT {{baseUrl}}/api/org/members/{{bobEmail}}/active
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "active": true }

?? status == 204

###

# @name org_active_a_withdrawn_share_does_not_come_back_on_unblock
GET {{baseUrl}}/api/shares
Authorization: Bearer {{bobToken}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 200

{{
  const assert = require('node:assert');
  test('withdrawal is not a suspension: the inbox is empty after re-admission', () => {
    assert.strictEqual(response.parsedBody.length, 0);
  });
}}

###
# @uncovered 503 — a target whose record this build cannot read is refused with Retry-After and the file
#            left untouched; provoking it means corrupting a file under a running server, which is
#            machinery this rule does not ask for. OrgBlockingAdminTests and OrgBlockingGateTests write
#            the garbage and read the 503 back, on the admin route and on the gate.
