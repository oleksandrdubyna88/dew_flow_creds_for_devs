# @name org_active_refuses_a_target_in_another_domain
PUT {{baseUrl}}/api/org/members/somebody@another-company.example/active
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json
Accept: application/json

{ "active": false }

?? status == 403
