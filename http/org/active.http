{{
  const assert = require('node:assert');
  test('the refusal names the domain', () => {
    assert.match(response.parsedBody.error, /domain/i);
  });
}}

###
# The roster is configuration, and a gate that refused an officer would lock the break-glass quorum out
# of the only road into a blocked developer's vault. So an officer cannot be blocked: 409, never a no-op.
# @name org_active_refuses_an_officer_target
PUT {{baseUrl}}/api/org/members/{{officerEmail}}/active
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json
Accept: application/json

{ "active": false }

?? status == 409
?? header content-type matches ^application\/json

{{
  const assert = require('node:assert');
  test('409 says officer', () => {
    assert.match(response.parsedBody.error, /officer/i);
  });
}}

###

# @name org_active_refuses_a_caller_who_does_not_administer
PUT {{baseUrl}}/api/org/members/{{aliceEmail}}/active
Authorization: Bearer {{bobToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json
Accept: application/json

{ "active": true }

?? status == 403
?? header content-type matches ^application\/json

{{
  const assert = require('node:assert');
  test('the refusal says why in the JSON this surface promises — and carries no deactivation header, Bob is fine', () => {
    assert.strictEqual(typeof response.parsedBody.error, 'string');
    assert.strictEqual(response.headers['x-creds-reason'], undefined);
  });
}}

###

# @name org_active_refuses_an_unauthenticated_caller
PUT {{baseUrl}}/api/org/members/{{aliceEmail}}/active
X-Creds-Contract: {{contract}}
Content-Type: application/json
Accept: application/json

{ "active": true }

?? status == 401
?? header content-type matches ^application\/json

