# @name org_events_refuses_a_limit_that_is_not_one
GET {{baseUrl}}/api/org/events?limit=0
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 400

{{
  const assert = require('node:assert');
  test('the refusal names the parameter', () => {
    assert.match(response.parsedBody.error, /limit/);
  });
}}

###

# @name org_events_refuses_a_range_that_ends_before_it_starts
GET {{baseUrl}}/api/org/events?since=2&until=1
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 400

{{
  const assert = require('node:assert');
  test('the refusal says which end is wrong', () => {
    assert.match(response.parsedBody.error, /until/);
  });
}}

###
# @uncovered 503 — two files this build cannot read: the caller's own registry record, which decides
#            their scope, and a day file of the log itself. Both need a file corrupted or locked
#            underneath a running server, which is machinery this tier does not ask for.
#            OrgEventsEndpointTests covers the record's 503 over HTTP and OrgEventLogQueryTests
#            covers the log's, by holding the file open.
# @uncovered 200 with a capped limit — a limit above the server's maximum is served rather than
#            refused, which looks identical over the wire to a limit the server accepted whole. The
#            cap is asserted in OrgEventsEndpointTests, where the page size can be observed.
