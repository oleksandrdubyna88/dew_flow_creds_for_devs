# @name org_events_needs_a_token
GET {{baseUrl}}/api/org/events
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 401
?? header content-type matches ^application\/json

{{
  const assert = require('node:assert');
  test('the refusal is a sentence, not an empty body', () => {
    assert.ok(response.parsedBody.error.length > 0);
  });
}}

###

# @name org_events_refuses_a_cursor_it_did_not_hand_out
GET {{baseUrl}}/api/org/events?cursor=yesterday
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 400
?? header content-type matches ^application\/json

{{
  const assert = require('node:assert');
  test('the refusal names the parameter', () => {
    assert.match(response.parsedBody.error, /cursor/);
  });
}}

