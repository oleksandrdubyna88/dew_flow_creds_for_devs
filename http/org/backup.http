# @name org_backup_settings_bounds_the_window
PUT {{baseUrl}}/api/org/backup/settings
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "scheduleHourUtc": 3, "retentionDays": 0 }

?? status == 400

{{
  const assert = require('node:assert');
  test('zero retention is refused, because this pass never empties the destination', () => {
    assert.match(response.parsedBody.error, /at least one day/);
  });
}}

