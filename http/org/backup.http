# @name org_backup_key_minted_once
POST {{baseUrl}}/api/org/backup/key
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 200
?? header content-type matches ^application\/json

{{
  const assert = require('node:assert');
  const minted = response.parsedBody;
  test('the words are printable, checksummed, and exactly 150 bits', () => {
    assert.match(minted.key, /^BK1(-[0-9A-HJKMNP-TV-Z]{4,5})+$/,
      'Crockford Base32 in groups, with a checksum — no I, L, O or U');
    assert.equal(minted.entropyBits, 150, 'reported unrounded, because it is exact');
  });
  test('and nothing else comes back with them', () => {
    assert.deepEqual(Object.keys(minted).sort(), ['entropyBits', 'key']);
  });
}}

