# @name org_backup_target_of_an_unknown_kind_is_refused
PUT {{baseUrl}}/api/org/backup/settings
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{
  "scheduleHourUtc": 4,
  "retentionDays": 14,
  "targets": [
    { "kind": "ftp", "endpoint": "https://example.com", "region": "", "bucket": "vaults",
      "prefix": "", "accessKeyId": "a", "secretAccessKey": "b" }
  ]
}

?? status == 400

{{
  const assert = require('node:assert');
  test('the refusal names the two kinds this server takes', () => {
    assert.match(response.parsedBody.error, /s3/);
    assert.match(response.parsedBody.error, /azure-blob/);
  });
}}

