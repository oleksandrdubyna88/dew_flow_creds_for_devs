# @name org_backup_settings_bounds_the_hour
PUT {{baseUrl}}/api/org/backup/settings
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{ "scheduleHourUtc": 24, "retentionDays": 30 }

?? status == 400

{{
  const assert = require('node:assert');
  test('the refusal names the range rather than saying "invalid"', () => {
    assert.match(response.parsedBody.error, /0 to 23/);
  });
}}

