# @name org_backup_key_cannot_be_shown_twice
POST {{baseUrl}}/api/org/backup/key
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 409

{{
  const assert = require('node:assert');
  test('the refusal explains that the words are gone, not that the request was wrong', () => {
    assert.match(response.parsedBody.error, /cannot be produced a second time/);
  });
}}

