# The encrypted backup — /api/org/backup/*, epic 5 story 3.
#
# Five routes an administrator presses, and every one of them is admin-only: the backup key opens
# every vault this server holds and the download is a copy of all of them, so there is no read here a
# developer has business making.
#
# The properties worth a real request rather than a unit test:
#
#   - the KEY is handed over exactly once, and asking again is refused with the reason it cannot be
#     produced a second time (what the server keeps is the derived key; HKDF does not run backwards);
#   - the RUN is detached — 202 and the work continues past the response — so the STATUS is the only
#     place its outcome appears, and rule 8 says that status must survive a reload;
#   - the DOWNLOAD answers 404 with a sentence when there is no archive, rather than starting a run:
#     a GET with a side effect would start one per retry;
#   - rotation is 501 with a decision in it, not 404 with silence.
#
# PRECONDITION: a corp-mode server (../README.md — three officers). `{{officerToken}}` administers;
# `{{token}}` (Alice) does not. This file MINTS a backup key on the server it runs against and takes a
# real archive, so run it against a scratch stack rather than anything you care about — the key it
# prints is the only copy that will ever exist.

# @name org_backup_status_is_admin_only
GET {{baseUrl}}/api/org/backup/status
Authorization: Bearer {{token}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 403
?? header content-type matches ^application\/json

{{
  const assert = require('node:assert');
  test('the refusal is JSON with a reason, not an empty body', () => {
    assert.ok(typeof response.parsedBody.error === 'string' && response.parsedBody.error.length > 0);
  });
}}

###

# @name org_backup_status_before_anything
GET {{baseUrl}}/api/org/backup/status
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 200
?? header content-type matches ^application\/json

{{
  const assert = require('node:assert');
  const status = response.parsedBody;
  test('the shape a page draws from, with running DERIVED rather than stored twice', () => {
    for (const field of ['configured', 'keyState', 'scheduleHourUtc', 'retentionDays',
                         'lastRunAt', 'lastResult', 'lastError', 'running',
                         'localArchiveBytes', 'localArchiveName']) {
      assert.ok(field in status, `${field} is part of the document`);
    }
    assert.equal(typeof status.running, 'boolean');
    assert.equal(status.running, status.lastResult === 'in progress',
      'running is derived from the persisted result — two fields could disagree');
  });
  test('the schedule and the window are the shell backup\'s own defaults on a fresh server', () => {
    assert.ok(status.scheduleHourUtc >= 0 && status.scheduleHourUtc <= 23);
    assert.ok(status.retentionDays >= 1);
  });
}}

