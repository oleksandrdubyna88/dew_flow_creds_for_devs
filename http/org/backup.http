# @name org_backup_rotate_is_a_decision_not_a_gap
POST {{baseUrl}}/api/org/backup/key/rotate
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Accept: application/json

?? status == 501

{{
  const assert = require('node:assert');
  test('501 with the reason, because 404 would read as "not built yet"', () => {
    assert.match(response.parsedBody.error, /orphans all of them/);
  });
}}

# The two statuses the wire cannot provoke from outside:
#
# @uncovered 409 POST /api/org/backup/run — a second run while one is live. Provoking it means racing
#   a real archive build from a request file; the endpoint tests hold the claim directly instead.
# @uncovered 400 PUT /api/org/backup/settings — a target that is well-formed and UNREACHABLE. The
#   refusal needs a host that fails to resolve, and a request file that depends on DNS failing is a
#   request file that fails differently on every network. BackupEndpointTests drives it in-process.
# @uncovered 200 GET /api/org/backup/archive — streaming the archive needs the run above to have
#   FINISHED, which is a wait this suite has no way to express. Asserted over real HTTP in
#   BackupEndpointTests, including the CVBK marker and the Content-Length matching the body.
