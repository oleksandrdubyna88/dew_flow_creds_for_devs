# @name org_backup_target_over_plain_http_is_refused
PUT {{baseUrl}}/api/org/backup/settings
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{
  "scheduleHourUtc": 4,
  "retentionDays": 14,
  "targets": [
    { "kind": "s3", "endpoint": "http://s3.example.com", "region": "eu-central-1",
      "bucket": "vaults", "prefix": "backups",
      "accessKeyId": "AKIDEXAMPLE", "secretAccessKey": "not-a-real-secret" }
  ]
}

?? status == 400

{{
  const assert = require('node:assert');
  test('refused without a round trip, because the archive body is not covered by the signature', () => {
    assert.match(response.parsedBody.error, /must be https/);
  });
  test('and the refusal names WHICH target, since a settings document can carry several', () => {
    assert.match(response.parsedBody.error, /s3 vaults\/backups/);
  });
}}

