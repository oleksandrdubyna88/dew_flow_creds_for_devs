# @name org_backup_first_save_of_a_target_needs_its_credentials
PUT {{baseUrl}}/api/org/backup/settings
Authorization: Bearer {{officerToken}}
X-Creds-Contract: {{contract}}
Content-Type: application/json

{
  "scheduleHourUtc": 4,
  "retentionDays": 14,
  "targets": [
    { "kind": "s3", "endpoint": "https://s3.example.com", "region": "eu-central-1",
      "bucket": "vaults", "prefix": "backups" }
  ]
}

?? status == 400

{{
  const assert = require('node:assert');
  test('and the message says what a LATER edit does, since nothing ever shows them again', () => {
    assert.match(response.parsedBody.error, /required the first time this target is saved/);
    assert.match(response.parsedBody.error, /keeps the ones already here/);
  });
}}

